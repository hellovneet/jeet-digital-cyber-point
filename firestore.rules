rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /updates/{updateId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null
        && request.auth.token.email == "ps9905965@gmail.com";
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
